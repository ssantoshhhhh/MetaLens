# All variables are optional. MetaLens runs without a database or AI key.

# Enables accounts and saved history (both are required).
# DATABASE_URL="postgresql://metalens:change-me@localhost:5432/metalens"
# AUTH_SECRET="" # At least 32 characters: openssl rand -base64 32

# Enables optional AI visual analysis.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"


# Reverse geocoding. Set a descriptive agent for public deployments.
# NOMINATIM_URL="https://nominatim.openstreetmap.org"
# NOMINATIM_USER_AGENT="YourApp/1.0 (contact-url-or-email)"
